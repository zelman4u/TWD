{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered system user profile (Administrator, Staff, or Registered Consumer)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique user ID" },
        "email": { "type": "string", "maxLength": 256, "description": "User email address" },
        "name": { "type": "string", "maxLength": 200, "description": "Full name of the user" },
        "role": { "type": "string", "enum": ["admin", "consumer", "staff", "cashier", "meter_reader"], "description": "System role" },
        "linkedAccountNumber": { "type": "string", "maxLength": 64, "description": "Associated water meter account number" },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended", "pending", "pending_approval", "pending_installation", "installation_not_scheduled"], "description": "Account status" },
        "password": { "type": "string", "maxLength": 256, "description": "Portal credential" },
        "registrationDate": { "type": "string", "maxLength": 64, "description": "Creation date" }
      },
      "required": ["name", "role", "status"]
    },
    "Consumer": {
      "title": "Consumer",
      "description": "Water service connection profile and billing master record",
      "type": "object",
      "properties": {
        "accountNumber": { "type": "string", "maxLength": 64, "description": "Official account number" },
        "name": { "type": "string", "maxLength": 200, "description": "Account holder name" },
        "address": { "type": "string", "maxLength": 500, "description": "Physical connection address" },
        "barangayId": { "type": "string", "maxLength": 64, "description": "Barangay code identifier" },
        "barangay": { "type": "string", "maxLength": 128, "description": "Barangay name" },
        "sitioZone": { "type": "string", "maxLength": 200, "description": "Zone or sitio details" },
        "contactNumber": { "type": "string", "maxLength": 64, "description": "Contact phone number" },
        "email": { "type": "string", "maxLength": 256, "description": "Email address" },
        "meterNumber": { "type": "string", "maxLength": 64, "description": "Official meter tag number" },
        "rfidTag": { "type": "string", "maxLength": 64, "description": "RFID hardware tag identifier" },
        "status": { "type": "string", "enum": ["active", "inactive", "archived", "disconnected", "pending", "pending_approval", "pending_installation", "installation_not_scheduled", "maintenance", "temporary_cutoff", "Disconnection Notice"], "description": "Connection status" },
        "applicationNumber": { "type": "string", "maxLength": 64, "description": "Registration application number" },
        "hasExistingMeter": { "type": "boolean", "description": "Whether consumer already had an installed water meter at registration" },
        "installationRequestId": { "type": "string", "maxLength": 128, "description": "Linked water meter installation request ID" },
        "installationStatus": { "type": "string", "maxLength": 64, "description": "Current water meter installation status" },
        "accountValidationStatus": { "type": "string", "maxLength": 64, "description": "Post-installation account validation state" },
        "isRegistered": { "type": "boolean", "description": "Whether consumer has created an online account" },
        "registrationDate": { "type": "string", "maxLength": 64, "description": "Date registered" },
        "linkedUserId": { "type": "string", "maxLength": 128, "description": "Linked user profile ID" },
        "consumerType": { "type": "string", "enum": ["Residential", "Commercial", "Institutional"], "description": "Tariff classification" },
        "meterSize": { "type": "string", "maxLength": 32, "description": "Meter physical pipe size" },
        "householdInfo": { "type": "string", "maxLength": 256, "description": "Additional consumer metadata" }
      },
      "required": ["name", "status"]
    },
    "MeterReader": {
      "title": "MeterReader",
      "description": "Field water meter reader personnel account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Reader ID" },
        "employeeId": { "type": "string", "maxLength": 128, "description": "Employee badge ID" },
        "name": { "type": "string", "maxLength": 200, "description": "Reader full name" },
        "username": { "type": "string", "maxLength": 256, "description": "Reader login username" },
        "employmentStatus": { "type": "string", "enum": ["active", "pending", "inactive"], "description": "Employment status" }
      },
      "required": ["id", "name"]
    },
    "WaterMeter": {
      "title": "WaterMeter",
      "description": "Physical water meter asset registration",
      "type": "object",
      "properties": {
        "meterNumber": { "type": "string", "maxLength": 64, "description": "Official meter tag number" },
        "serialNumber": { "type": "string", "maxLength": 64, "description": "Physical water meter serial number (Water Meters module only)" },
        "rfidTag": { "type": "string", "maxLength": 64, "description": "RFID tag" },
        "linkedAccountNumber": { "type": "string", "maxLength": 64, "description": "Linked consumer account number" },
        "installationDate": { "type": "string", "maxLength": 64, "description": "Installation date" },
        "completionDate": { "type": "string", "maxLength": 64, "description": "Installation completion date" },
        "installedBy": { "type": "string", "maxLength": 200, "description": "Responsible installation personnel" },
        "brand": { "type": "string", "maxLength": 128, "description": "Brand manufacturer" },
        "size": { "type": "string", "maxLength": 32, "description": "Pipe size" },
        "status": { "type": "string", "enum": ["active", "inactive", "damaged", "maintenance", "unassigned"], "description": "Asset condition status" },
        "remarks": { "type": "string", "maxLength": 1000, "description": "Administrator remarks for the status update" },
        "previousStatus": { "type": "string", "maxLength": 64, "description": "Previous water meter status" },
        "statusUpdatedAt": { "type": "string", "maxLength": 64, "description": "Timestamp of last status update" },
        "statusUpdatedBy": { "type": "string", "maxLength": 200, "description": "Administrator who updated the meter status" }
      },
      "required": ["meterNumber", "status"]
    },
    "MeterReading": {
      "title": "MeterReading",
      "description": "Monthly water volume reading and billing statement record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Reading statement unique ID" },
        "accountNumber": { "type": "string", "maxLength": 64, "description": "Consumer account number" },
        "meterNumber": { "type": "string", "maxLength": 64, "description": "Meter serial number" },
        "consumerName": { "type": "string", "maxLength": 200, "description": "Consumer name" },
        "previousReading": { "type": "number", "description": "Previous meter reading in m3" },
        "currentReading": { "type": "number", "description": "Current meter reading in m3" },
        "consumption": { "type": "number", "description": "Net consumption volume in m3" },
        "readingDate": { "type": "string", "maxLength": 64, "description": "Date reading was captured" },
        "billingPeriod": { "type": "string", "maxLength": 64, "description": "Billing period month and year" },
        "status": { "type": "string", "description": "Verification status" },
        "paymentStatus": { "type": "string", "description": "Payment status" }
      },
      "required": ["id", "accountNumber", "consumption"]
    },
    "RouteAssignment": {
      "title": "RouteAssignment",
      "description": "Field reading route schedule and reader allocation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Route ID" },
        "status": { "type": "string", "description": "Progress state" }
      },
      "required": ["id"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Public water district advisory and service maintenance bulletin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Announcement bulletin ID" },
        "title": { "type": "string", "maxLength": 300, "description": "Subject header" },
        "content": { "type": "string", "maxLength": 5000, "description": "Detailed advisory text" },
        "date": { "type": "string", "maxLength": 64, "description": "Publish date" },
        "category": { "type": "string", "description": "Topic category" }
      },
      "required": ["id", "title", "content"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System security and administrative change trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Log record ID" },
        "timestamp": { "type": "string", "maxLength": 64, "description": "ISO execution timestamp" },
        "userId": { "type": "string", "maxLength": 128, "description": "Actor user ID" },
        "userName": { "type": "string", "maxLength": 200, "description": "Actor user name" },
        "userRole": { "type": "string", "description": "Actor system role" },
        "action": { "type": "string", "maxLength": 300, "description": "Action performed" },
        "details": { "type": "string", "maxLength": 2000, "description": "Operation details" }
      },
      "required": ["id", "timestamp", "action"]
    },
    "ConsumerNotification": {
      "title": "ConsumerNotification",
      "description": "Account alerts, ID issuance confirmations, billing notifications, and advisories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Notification ID" },
        "accountNumber": { "type": "string", "maxLength": 64, "description": "Target consumer account number" },
        "userId": { "type": "string", "maxLength": 128, "description": "Target user ID" },
        "consumerEmail": { "type": "string", "maxLength": 256, "description": "Target consumer email" },
        "title": { "type": "string", "maxLength": 300, "description": "Title" },
        "message": { "type": "string", "maxLength": 2000, "description": "Message text" },
        "timestamp": { "type": "string", "maxLength": 64, "description": "ISO timestamp" },
        "read": { "type": "boolean", "description": "Read status" },
        "type": { "type": "string", "description": "Notification category" },
        "subject": { "type": "string", "maxLength": 300, "description": "Notification subject line" },
        "consumerName": { "type": "string", "maxLength": 200, "description": "Target consumer full name" },
        "meterNumber": { "type": "string", "maxLength": 64, "description": "Associated water meter serial number" },
        "meterStatus": { "type": "string", "enum": ["active", "inactive", "damaged", "maintenance"], "description": "Updated water meter status" },
        "previousMeterStatus": { "type": "string", "maxLength": 64, "description": "Previous water meter status" },
        "statusUpdateDate": { "type": "string", "maxLength": 64, "description": "ISO timestamp of status update" },
        "remarks": { "type": "string", "maxLength": 1000, "description": "Administrator remarks" },
        "updatedByAdmin": { "type": "string", "maxLength": 200, "description": "Administrator responsible for update" }
      },
      "required": ["id", "title", "message", "type"]
    },
    "Barangay": {
      "title": "Barangay",
      "description": "Municipal barangay water service zone",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "description": "Barangay ID" },
        "name": { "type": "string", "maxLength": 128, "description": "Barangay name" },
        "code": { "type": "string", "maxLength": 32, "description": "Barangay code" }
      },
      "required": ["id", "name"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "District tariff and operational configuration settings",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Last update timestamp" }
      }
    },
    "ConsumerReport": {
      "title": "ConsumerReport",
      "description": "Consumer service reports, issues, water leaks, billing complaints, and admin replies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Report identifier" },
        "ticketNumber": { "type": "string", "maxLength": 64, "description": "Official tracking ticket code" },
        "accountNumber": { "type": "string", "maxLength": 64, "description": "Consumer account number" },
        "consumerName": { "type": "string", "maxLength": 200, "description": "Consumer name" },
        "category": { "type": "string", "description": "Report category" },
        "title": { "type": "string", "maxLength": 300, "description": "Report title / summary" },
        "description": { "type": "string", "maxLength": 4000, "description": "Detailed explanation of concern" },
        "status": { "type": "string", "description": "Processing status" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "ISO creation timestamp" }
      },
      "required": ["id", "ticketNumber", "title", "status"]
    },
    "InstallationRequest": {
      "title": "InstallationRequest",
      "description": "New consumer water meter installation scheduling and post-installation account validation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Installation request ID" },
        "applicationNumber": { "type": "string", "maxLength": 64, "description": "Official registration/application number" },
        "linkedUserId": { "type": "string", "maxLength": 128, "description": "Consumer portal user ID" },
        "consumerName": { "type": "string", "maxLength": 200, "description": "Applicant full name" },
        "consumerEmail": { "type": "string", "maxLength": 256, "description": "Applicant email address" },
        "contactNumber": { "type": "string", "maxLength": 64, "description": "Applicant contact number" },
        "address": { "type": "string", "maxLength": 500, "description": "Service installation address" },
        "barangay": { "type": "string", "maxLength": 128, "description": "Service barangay" },
        "preferredInstallationDate": { "type": "string", "maxLength": 64, "description": "Consumer preferred installation date" },
        "confirmedInstallationDate": { "type": "string", "maxLength": 64, "description": "Admin confirmed installation date" },
        "consumerRemarks": { "type": "string", "maxLength": 1000, "description": "Consumer installation instructions" },
        "adminRemarks": { "type": "string", "maxLength": 1000, "description": "Administrator remarks" },
        "submissionDate": { "type": "string", "maxLength": 64, "description": "ISO submission date" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "ISO last updated date" },
        "status": { "type": "string", "enum": ["Pending Review", "Approved", "Scheduled", "Rescheduled", "Installation in Progress", "Installed", "Cancelled"], "description": "Installation request status" },
        "completionDate": { "type": "string", "maxLength": 64, "description": "Physical installation completion date" },
        "responsiblePersonnel": { "type": "string", "maxLength": 200, "description": "Personnel who completed physical installation" },
        "meterSerialNumber": { "type": "string", "maxLength": 64, "description": "Physical water meter serial number (Water Meters module only)" },
        "assignedMeterTagNumber": { "type": "string", "maxLength": 64, "description": "Issued official meter tag number" },
        "assignedAccountNumber": { "type": "string", "maxLength": 64, "description": "Issued official consumer account number" },
        "accountValidationStatus": { "type": "string", "enum": ["pending_installation", "awaiting_validation", "validated"], "description": "Account validation state" }
      },
      "required": ["id", "applicationNumber", "consumerName", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records"
    },
    "/consumers/{accountNumber}": {
      "schema": "Consumer",
      "description": "Official water connection accounts"
    },
    "/readers/{readerId}": {
      "schema": "MeterReader",
      "description": "Field water meter reader personnel"
    },
    "/meters/{meterId}": {
      "schema": "WaterMeter",
      "description": "Physical water meter asset registry"
    },
    "/readings/{readingId}": {
      "schema": "MeterReading",
      "description": "Historical meter readings and monthly bills"
    },
    "/routes/{routeId}": {
      "schema": "RouteAssignment",
      "description": "Field reading route management"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Public district advisories"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System and administrative action logs"
    },
    "/notifications/{notificationId}": {
      "schema": "ConsumerNotification",
      "description": "Direct consumer alerts, ID issuance confirmations, and billing reminders"
    },
    "/barangays/{barangayId}": {
      "schema": "Barangay",
      "description": "Tagoloan municipal barangays"
    },
    "/settings/{settingId}": {
      "schema": "SystemSetting",
      "description": "District tariff and system settings"
    },
    "/consumer_reports/{reportId}": {
      "schema": "ConsumerReport",
      "description": "Consumer service complaints, water incident reports, and district replies"
    },
    "/installation_requests/{requestId}": {
      "schema": "InstallationRequest",
      "description": "New consumer water meter installation scheduling and validation records"
    }
  }
}
